generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email     String  @unique
  password  String
  role      String?  // "agent" or "admin"
  agentName String?
   createdAt     DateTime?  @default(now())
  updatedAt     DateTime?  @updatedAt
}

model Trip {
  id          Int      @id @default(autoincrement())
  destination String
  price       Float
  margin      Float
  date        DateTime
  transport   String
  duration    Int
  description String
  isAvailable Boolean
  imageUrl    String   // New field for the image URL
}

