generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email     String  @unique
  password  String
  role      String?  // "agent" or "admin"
  agentName String?
   createdAt     DateTime?  @default(now())
  updatedAt     DateTime?  @updatedAt
}

model Trip {
    id            String    @id @default(cuid())
  
  destination String
  price      Float
  margin     Float
  date       DateTime
}
